{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "extremeeditor-together-bundle",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-16",
  "r2_buckets": [{ "binding": "BUNDLES", "bucket_name": "extremeeditor-together-bundles" }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "BundleRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BundleRoom"] }]
}
