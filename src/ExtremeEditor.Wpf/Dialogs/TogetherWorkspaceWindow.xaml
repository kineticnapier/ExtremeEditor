<Window x:Class="ExtremeEditor.Wpf.TogetherWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExtremeEditor Together" Width="840" Height="700"
        MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Local workspace" Grid.Row="0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="102"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Workspace path" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
                <TextBox x:Name="WorkspacePathBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                         MinWidth="280" Margin="4" ToolTip="New empty folder for Create; existing Together folder for Open"/>
                <TextBlock Text="My owner ID" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
                <TextBox x:Name="OwnerIdBox" Grid.Row="1" Grid.Column="1" Margin="4" Text="author-A"/>
                <TextBlock Text="Sample rate" VerticalAlignment="Center" Grid.Row="1" Grid.Column="2"/>
                <TextBox x:Name="SampleRateBox" Grid.Row="1" Grid.Column="3" Margin="4" Text="48000"/>
                <TextBlock Text="Cut floors" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
                <TextBox x:Name="CutFloorsBox" Grid.Row="2" Grid.Column="1" Margin="4" Text="3"
                         ToolTip="Comma-separated floor numbers, e.g. 3,6. Whole-floor boundaries only."/>
                <TextBlock Text="Owners" VerticalAlignment="Center" Grid.Row="2" Grid.Column="2"/>
                <TextBox x:Name="OwnersBox" Grid.Row="2" Grid.Column="3" Margin="4"
                         Text="author-A,author-B"
                         ToolTip="Comma-separated owner IDs; one for each region. First is A, second B."/>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="CreateWorkspaceButton" Content="Create" Width="105" Margin="0,0,8,0"
                            Click="CreateWorkspaceClick"/>
                    <Button x:Name="OpenWorkspaceButton" Content="Open existing" Width="112"
                            Margin="0,0,8,0" Click="OpenWorkspaceClick"/>
                    <Button x:Name="ReloadViewButton" Content="Reload editor from Git"
                            Width="170" Click="ReloadViewClick"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Local bare Git collaboration" Margin="0,8,0,0" Padding="8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Connect" Width="80" Margin="6,0,0,0" Click="ConnectClick"/>
                    <Button x:Name="FetchButton" Content="Fetch" Width="70"
                            Margin="6,0,0,0" Click="FetchClick"/>
                    <Button x:Name="PullButton" Content="Pull" Width="70"
                            Margin="6,0,0,0" Click="PullClick"/>
                    <Button x:Name="PushButton" Content="Push" Width="70"
                            Margin="6,0,0,0" Click="PushClick"/>
                </StackPanel>
                <TextBox x:Name="BareRemoteBox" MinWidth="220" VerticalAlignment="Center"
                         ToolTip="Trusted local bare Git repository path; no URL or SSH remotes"/>
            </DockPanel>
        </GroupBox>

        <GroupBox Header="Segments — select your own active region to stage" Grid.Row="2" Margin="0,8,0,0" Padding="8">
            <ListView x:Name="SegmentList" SelectionChanged="SegmentSelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" Width="70" DisplayMemberBinding="{Binding SegmentId}"/>
                        <GridViewColumn Header="Owner" Width="110" DisplayMemberBinding="{Binding OwnerId}"/>
                        <GridViewColumn Header="State" Width="75" DisplayMemberBinding="{Binding Status}"/>
                        <GridViewColumn Header="Start floor" Width="85" DisplayMemberBinding="{Binding StartFloor}"/>
                        <GridViewColumn Header="End floor" Width="85" DisplayMemberBinding="{Binding EndFloorExclusive}"/>
                        <GridViewColumn Header="Start sample" Width="120" DisplayMemberBinding="{Binding StartSample}"/>
                        <GridViewColumn Header="End sample" Width="120" DisplayMemberBinding="{Binding EndSampleExclusive}"/>
                        <GridViewColumn Header="Writable" Width="70" DisplayMemberBinding="{Binding CanEdit}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                <Button x:Name="SaveSegmentButton" Content="Stage selected Segment"
                        Padding="12,6" Click="SaveSegmentClick" Margin="0,0,8,0"/>
                <Button x:Name="CommitButton" Content="Commit" Padding="12,6"
                        Click="CommitClick" Margin="0,0,8,0"/>
            </StackPanel>
            <TextBox x:Name="CommitMessageBox" Grid.Column="1" Margin="4,0,8,0"
                     VerticalContentAlignment="Center" Text="Edit selected Segment"/>
            <Button x:Name="ExportButton" Grid.Column="2"
                    Content="Export published .adofai…" Padding="10,6" Click="ExportClick"/>
        </Grid>

        <Border Grid.Row="4" BorderThickness="1" BorderBrush="#FF909090"
                Padding="8" Margin="0,10,0,0">
            <TextBlock x:Name="TogetherStatusText" Text="No Together workspace opened."
                       TextWrapping="Wrap" MinHeight="38"/>
        </Border>
    </Grid>
</Window>