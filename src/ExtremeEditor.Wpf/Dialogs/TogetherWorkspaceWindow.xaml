<Window x:Class="ExtremeEditor.Wpf.TogetherWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExtremeEditor.Wpf"
        Title="ExtremeEditor 共同編集" Width="1040" Height="900"
        MinWidth="860" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Loaded="TogetherWindowLoaded"
        Closed="TogetherWindowClosed"
        PreviewKeyDown="TogetherPreviewKeyDown"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Window.Resources>
        <Style x:Key="PrimaryTogetherButton" TargetType="Button">
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinHeight" Value="43"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SecondaryTogetherButton" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="共同編集" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="ProjectOverviewText"
                       Text="音源または既存の譜面を選び、曲を区切って担当者を決めるだけで共同制作を始められます。"
                       TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF555555"/>
            <TextBlock Text="新しく作る場合は「共同編集を作成」、参加する場合は「共同編集に参加」を選んでください。"
                       TextWrapping="Wrap" Foreground="#FF777777" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CreateProjectButton" Grid.Column="0" Content="＋ 共同編集を作成"
                    Margin="0,0,6,0" Padding="14,12" FontSize="15"
                    Click="ShowCreateProjectClick"/>
            <Button x:Name="JoinProjectButton" Grid.Column="1" Content="共同編集に参加"
                    Margin="6,0,0,0" Padding="14,12" FontSize="15"
                    Click="ShowJoinProjectClick"/>
        </Grid>

        <GroupBox x:Name="SetupPanel" Grid.Row="2" Header="共同編集の準備"
                  Visibility="Collapsed" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="保存先フォルダー" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center"/>
                <TextBox x:Name="WorkspacePathBox" Grid.Column="1" Grid.Row="0" Margin="5,2"
                         ToolTip="作成時は新しい空フォルダー、参加時は既存のTogether作業フォルダーのパス"/>
                <TextBlock Text="参加者名" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"/>
                <DockPanel Grid.Column="1" Grid.Row="1" Margin="5,2">
                    <Button x:Name="ChooseParticipantButton" Content="この名前で編集"
                            DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,4"
                            Click="ChooseParticipantClick"/>
                    <ComboBox x:Name="ParticipantNameBox" IsEditable="True"
                              Text="" ToolTip="共同編集を開いた後、担当者一覧から自分の名前を選択してください"/>
                </DockPanel>
                <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal"
                            Margin="5,8,0,2">
                    <Button x:Name="CreateWorkspaceButton" Content="この譜面から作成"
                            Style="{StaticResource SecondaryTogetherButton}"
                            Click="CreateWorkspaceClick"/>
                    <Button x:Name="OpenWorkspaceButton" Content="既存の作業フォルダーを開く"
                            Style="{StaticResource SecondaryTogetherButton}"
                            Click="OpenWorkspaceClick"/>
                    <Button x:Name="CloneWorkspaceButton" Content="Git共有先から複製して参加"
                            Style="{StaticResource SecondaryTogetherButton}"
                            Click="CloneWorkspaceClick"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="音楽タイムライン" Padding="9"
                  Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="190"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="BPM" VerticalAlignment="Center"/>
                    <TextBox x:Name="BpmBox" Grid.Column="1" Text="120"
                             Margin="5,0,12,0" LostFocus="MusicGridSettingsChanged"/>
                    <TextBlock Grid.Column="2" Text="拍オフセット(ms)" VerticalAlignment="Center"/>
                    <TextBox x:Name="BeatOffsetBox" Grid.Column="3" Text="0"
                             Margin="5,0,12,0" LostFocus="MusicGridSettingsChanged"
                             ToolTip="音楽グリッドの基準時刻。ADOFAIのOffsetとは別に確認してください"/>
                    <TextBlock Grid.Column="4" Text="スナップ" VerticalAlignment="Center"/>
                    <ComboBox x:Name="SnapSubdivisionBox" Grid.Column="5"
                              SelectedIndex="3" Margin="5,0,12,0"
                              SelectionChanged="SnapSubdivisionChanged">
                        <ComboBoxItem Content="1/1" Tag="1"/>
                        <ComboBoxItem Content="1/2" Tag="2"/>
                        <ComboBoxItem Content="1/3" Tag="3"/>
                        <ComboBoxItem Content="1/4" Tag="4"/>
                        <ComboBoxItem Content="1/8" Tag="8"/>
                        <ComboBoxItem Content="1/16" Tag="16"/>
                    </ComboBox>
                    <TextBlock x:Name="MeasuredAudioText" Grid.Column="6"
                               Text="音源を読み込むと実測情報を表示します"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="7" Content="音源を選択…" Padding="10,4"
                            Click="BrowseTimelineAudioClick"/>
                </Grid>
                <Grid Grid.Row="1" ClipToBounds="True">
                    <local:TogetherMusicTimelineControl x:Name="MusicTimeline"
                        Focusable="True"
                        SelectionChanged="MusicTimelineSelectionChanged"
                        SeekRequested="MusicTimelineSeekRequested"
                        EndpointRequested="MusicTimelineEndpointRequested"
                        ToolTip="クリック: シーク / Shift+クリック: 始点 / Alt+クリック: 終点 / Ctrl+ホイール: ズーム / ホイール: 左右移動"/>
                    <Canvas IsHitTestVisible="False" ClipToBounds="True">
                        <Rectangle x:Name="PreviewPlayhead" Width="2" Fill="#FFFF8056"
                            Height="{Binding ActualHeight, ElementName=MusicTimeline}"
                            Visibility="Collapsed"/>
                    </Canvas>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,7,0,1">
                    <Button x:Name="PreviewPlayPauseButton" Content="再生 ▶" Padding="14,4"
                            Click="PreviewPlayPauseClick" IsEnabled="False"/>
                    <Button x:Name="PreviewStopButton" Content="停止 ■" Padding="14,4"
                            Margin="6,0,0,0" Click="PreviewStopClick" IsEnabled="False"/>
                    <CheckBox x:Name="PreviewLoopCheckBox" Content="選択区間をループ"
                              Margin="16,0,0,0" VerticalAlignment="Center"
                              ToolTip="始点・終点で選択した範囲、または担当区間をループ"/>
                    <TextBlock x:Name="PreviewPositionText" Text="00:00.000 / 00:00.000"
                               Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PreviewAudioStatusText" Text="音源を読み込むと試聴できます"
                               Margin="14,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Grid Grid.Row="3" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ズーム" VerticalAlignment="Center"/>
                    <Slider x:Name="TimelineZoomSlider" Grid.Column="1"
                            Minimum="0" Maximum="1" Value="0" Margin="7,0,15,0"
                            ValueChanged="TimelineZoomChanged"/>
                    <TextBlock Grid.Column="2" Text="表示位置" VerticalAlignment="Center"/>
                    <ScrollBar x:Name="TimelineScrollBar" Grid.Column="3"
                               Orientation="Horizontal" Minimum="0" Maximum="0"
                               SmallChange="1000" LargeChange="10000"
                               ValueChanged="TimelineScrollChanged"/>
                </Grid>
                <StackPanel x:Name="SectionPlanningPanel" Grid.Row="4"
                            Orientation="Horizontal" Margin="0,1,0,6">
                    <Button x:Name="SplitSectionButton" Content="現在位置で区切る"
                            Padding="11,5" Click="SplitSectionClick"/>
                    <Button x:Name="JoinSectionButton" Content="次の区間と結合"
                            Margin="6,0,0,0" Padding="11,5" Click="JoinSectionClick"/>
                    <Button x:Name="MoveBoundaryButton" Content="境界を現在位置へ移動"
                            Margin="6,0,0,0" Padding="11,5" Click="MoveBoundaryClick"/>
                    <TextBlock Text="担当者" Margin="18,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="SegmentOwnerBox" Width="130" Margin="6,0"
                             ToolTip="選択中の区間を担当する人の名前"/>
                    <Button x:Name="AssignOwnerButton" Content="担当者を設定"
                            Padding="11,5" Click="AssignOwnerClick"/>
                </StackPanel>
                <Expander x:Name="DetailedRangeExpander" Grid.Row="5"
                          Header="詳細な範囲指定" IsExpanded="False">
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="PreviewSetStartButton" Content="現在位置→始点"
                                Padding="9,5" Click="PreviewSetStartClick"/>
                        <Button x:Name="PreviewSetEndButton" Content="現在位置→終点"
                                Margin="6,0,0,0" Padding="9,5" Click="PreviewSetEndClick"/>
                        <TextBox x:Name="SelectionStartSampleText" Width="1"
                                 Visibility="Collapsed" IsReadOnly="True"/>
                        <TextBox x:Name="SelectionEndSampleText" Width="1"
                                 Visibility="Collapsed" IsReadOnly="True"/>
                        <Button x:Name="AddTimeSegmentButton" Content="選択範囲を区間として設定"
                                Margin="8,0,0,0" Padding="10,5" Click="AddTimeSegmentClick"/>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="#FF666666"
                                   Text="Shift+クリック: 始点 / Alt+クリック: 終点"/>
                    </StackPanel>
                </Expander>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="担当区間" Padding="9" MinHeight="145">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="区間を選びます。自分の担当区間では床を編集でき、ほかの人の区間は安全に閲覧できます。"
                           Foreground="#FF666666" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ListView x:Name="SegmentList" Grid.Row="1"
                          SelectionChanged="SegmentSelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="区間" Width="110"
                                            DisplayMemberBinding="{Binding DisplayName}"/>
                            <GridViewColumn Header="担当者" Width="125"
                                            DisplayMemberBinding="{Binding OwnerId}"/>
                            <GridViewColumn Header="状態" Width="80"
                                            DisplayMemberBinding="{Binding StateLabel}"/>
                            <GridViewColumn Header="曲中の範囲" Width="190"
                                            DisplayMemberBinding="{Binding TimeRangeLabel}"/>
                            <GridViewColumn Header="権限" Width="95"
                                            DisplayMemberBinding="{Binding WritableLabel}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="タイルID" VerticalAlignment="Center"/>
                    <TextBox x:Name="TimeTileIdBox" Grid.Column="1" Margin="5,0,10,0"
                             ToolTip="空欄なら自動採番"/>
                    <TextBlock Grid.Column="2" Text="角度" VerticalAlignment="Center"/>
                    <TextBox x:Name="TimeTileAngleBox" Grid.Column="3" Text="0"
                             Margin="5,0,10,0" ToolTip="ADOFAI destination angle（度）"/>
                    <Button x:Name="PlaceTimeTileButton" Grid.Column="4" Content="選択開始へ配置"
                            Padding="9,4" Margin="0,0,6,0" Click="PlaceTimeTileClick"/>
                    <Button x:Name="RemoveTimeTileButton" Grid.Column="5" Content="削除"
                            Padding="9,4" Margin="0,0,6,0" Click="RemoveTimeTileClick"/>
                    <Button x:Name="UndoTimeTileButton" Grid.Column="6" Content="元に戻す"
                            Padding="9,4" Margin="0,0,6,0" Click="UndoTimeTileClick"/>
                    <Button x:Name="RedoTimeTileButton" Grid.Column="7" Content="やり直す"
                            Padding="9,4" Margin="0,0,8,0" Click="RedoTimeTileClick"/>
                    <ListBox x:Name="AuthoredTileList" Grid.Column="8" Height="30"
                             DisplayMemberPath="TileId" ToolTip="選択中区間の実タイル"/>
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,7,0,0">
                    <TextBlock Text="区間の入口角度 (°)" VerticalAlignment="Center"/>
                    <TextBox x:Name="EntryAngleBox" Width="82" Text="0" Margin="8,0,8,0"
                             ToolTip="区間境界のADOFAI入口角度。自動補正しません"/>
                    <Button x:Name="SetEntryAngleButton" Content="入口角度を設定" Padding="9,4"
                            Click="SetEntryAngleClick"/>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                               Text="音楽BPMと書き出し時のADOFAI BPMは別です"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="5" Margin="0,12,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ShareChangesButton" Grid.Column="0"
                    Content="変更を共有" Style="{StaticResource PrimaryTogetherButton}"
                    Click="ShareChangesClick"/>
            <Button x:Name="ReceiveChangesButton" Grid.Column="1"
                    Content="最新の変更を取り込む" Style="{StaticResource SecondaryTogetherButton}"
                    Click="ReceiveChangesClick" VerticalAlignment="Center"/>
            <Button x:Name="ExportButton" Grid.Column="3"
                    Content="完成譜面を書き出す…" Style="{StaticResource PrimaryTogetherButton}"
                    Click="ExportClick" Margin="10,0,0,0"/>
        </Grid>

        <Expander x:Name="AdvancedControlsExpander" Grid.Row="6"
                  Header="詳細設定" IsExpanded="False"
                  Margin="0,5,0,8" MaxHeight="250">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,8,10,12">
                    <TextBlock Text="作成時の分割と担当者。音源をタイムラインへ読み込むと周波数を実測します。未読込時の48kHzは初期値です。"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="分割する床番号" VerticalAlignment="Center"/>
                        <TextBox x:Name="CutFloorsBox" Grid.Row="0" Grid.Column="1"
                                 Margin="5,3" ToolTip="カンマ区切り。空欄なら床数の中間で自動分割"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="担当者名（順番）" VerticalAlignment="Center"/>
                        <TextBox x:Name="OwnersBox" Grid.Row="0" Grid.Column="3"
                                 Margin="5,3" ToolTip="カンマ区切り。空欄なら先頭が自分、残りが他の編集者"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="音声サンプル周波数" VerticalAlignment="Center"/>
                        <TextBox x:Name="SampleRateBox" Grid.Row="1" Grid.Column="1" Text="48000"
                                 Margin="5,3" ToolTip="48,000 Hzは初期値です。使用する音声ファイルの実際のサンプル周波数を指定してください"/>
                        <CheckBox x:Name="ConfirmSampleRateBox" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                  VerticalAlignment="Center" Margin="8,3"
                                  Content="音声ファイルと照合した"/>
                    </Grid>
                    <Separator Margin="0,10"/>
                    <TextBlock Text="ローカルGit共有フォルダー（Bare Repository）のパス。通常のWeb招待リンクは使用できません。"
                               TextWrapping="Wrap"/>
                    <DockPanel Margin="0,4,0,4">
                        <Button Content="同期先を接続" DockPanel.Dock="Right"
                                Style="{StaticResource SecondaryTogetherButton}" Click="ConnectClick"/>
                        <TextBox x:Name="BareRemoteBox" Margin="0,2,5,2"
                                 ToolTip="ローカルのBare Gitリポジトリのパス"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                        <Button x:Name="ReloadViewButton" Content="Gitの内容を再読込"
                                Style="{StaticResource SecondaryTogetherButton}" Click="ReloadViewClick"/>
                        <Button x:Name="FetchButton" Content="取得（Fetch）"
                                Style="{StaticResource SecondaryTogetherButton}" Click="FetchClick"/>
                        <Button x:Name="PullButton" Content="統合（Pull）"
                                Style="{StaticResource SecondaryTogetherButton}" Click="PullClick"/>
                        <Button x:Name="PushButton" Content="送信（Push）"
                                Style="{StaticResource SecondaryTogetherButton}" Click="PushClick"/>
                    </StackPanel>
                    <Separator Margin="0,9"/>
                    <TextBlock Text="完成譜面の再生設定（ADOFAI）。音楽グリッドのBPMとは別に明示してください。"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <WrapPanel Margin="0,2,0,5">
                        <TextBlock Text="BPM" VerticalAlignment="Center"/>
                        <TextBox x:Name="ExportBpmBox" Width="73" Text="120" Margin="5,0,10,0"/>
                        <TextBlock Text="Offset(ms)" VerticalAlignment="Center"/>
                        <TextBox x:Name="ExportOffsetBox" Width="75" Text="0" Margin="5,0,10,0"/>
                        <TextBlock Text="Pitch(%)" VerticalAlignment="Center"/>
                        <TextBox x:Name="ExportPitchBox" Width="65" Text="100" Margin="5,0,10,0"/>
                        <TextBlock Text="Countdown" VerticalAlignment="Center"/>
                        <TextBox x:Name="ExportCountdownBox" Width="48" Text="0" Margin="5,0,10,0"/>
                        <CheckBox x:Name="ExportSeparateCountdownBox" Content="SeparateCountdownTime"
                                  IsChecked="False" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <TextBlock Text="Time-first完成譜面はコミット済みデータからのみ書き出します。音源は出力する.adofaiと同じフォルダーに、元と同じ内容・ファイル名で必要です。"
                               TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Button x:Name="SaveSegmentButton" Content="選択区間を準備（Stage）"
                                Style="{StaticResource SecondaryTogetherButton}" Click="SaveSegmentClick"/>
                        <Button x:Name="CommitButton" Content="履歴に記録（Commit）"
                                Style="{StaticResource SecondaryTogetherButton}" Click="CommitClick"/>
                        <TextBox x:Name="CommitMessageBox" Margin="5,2" MinWidth="180"
                                 VerticalContentAlignment="Center" Text="担当区間を編集"
                                 ToolTip="変更履歴の説明文"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Expander>

        <Border Grid.Row="7" BorderBrush="#FFAAAAAA"
                BorderThickness="1" Padding="9" MinHeight="46">
            <TextBlock x:Name="TogetherStatusText"
                       Text="共同編集はまだ開かれていません。.adofai 譜面を開いてから、作成または参加してください。"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
