<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <NativeRendererBuildDir>$(MSBuildThisFileDirectory)..\..\build\native-renderer</NativeRendererBuildDir>
    <NativeRendererDll>$(NativeRendererBuildDir)\$(Configuration)\ExtremeEditor.NativeRenderer.dll</NativeRendererDll>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ExtremeEditor.Core\ExtremeEditor.Core.csproj" />
    <ProjectReference Include="..\ExtremeEditor.Audio\ExtremeEditor.Audio.csproj" />
    <ProjectReference Include="..\ExtremeEditor.Rendering\ExtremeEditor.Rendering.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(NativeRendererDll)"
          Link="ExtremeEditor.NativeRenderer.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>
  <Target Name="BuildNativeRenderer" BeforeTargets="Build">
    <Exec Command="cmake -S &quot;$(MSBuildThisFileDirectory)..\ExtremeEditor.NativeRenderer&quot; -B &quot;$(NativeRendererBuildDir)&quot; -A x64" />
    <Exec Command="cmake --build &quot;$(NativeRendererBuildDir)&quot; --config $(Configuration)" />
  </Target>
</Project>
