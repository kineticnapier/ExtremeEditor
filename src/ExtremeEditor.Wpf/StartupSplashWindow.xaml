<Window x:Class="ExtremeEditor.Wpf.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        Height="320"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Grid>
        <Border CornerRadius="22"
                BorderBrush="#4CFFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34"
                                  ShadowDepth="0"
                                  Opacity="0.50"
                                  Color="#000000" />
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#191C2B" Offset="0" />
                    <GradientStop Color="#34205C" Offset="0.42" />
                    <GradientStop Color="#0D6C86" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid ClipToBounds="True">
                <Ellipse Width="300"
                         Height="300"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-130,-70,0"
                         Stroke="#45FFFFFF"
                         StrokeThickness="2" />
                <Ellipse Width="215"
                         Height="215"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-76,-30,0"
                         Stroke="#28FFFFFF"
                         StrokeThickness="1" />
                <Ellipse Width="160"
                         Height="160"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="-76,0,0,-90"
                         Fill="#1AFFFFFF" />

                <Grid Margin="44,38,44,34">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <Border Width="62"
                                Height="62"
                                CornerRadius="18"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF79D7" Offset="0" />
                                    <GradientStop Color="#8B7CFF" Offset="0.52" />
                                    <GradientStop Color="#5EE7F2" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="E"
                                       Foreground="White"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="ExtremeEditor"
                                   Foreground="White"
                                   FontSize="38"
                                   FontWeight="SemiBold"
                                   LetterSpacing="1" />
                        <TextBlock Text="ADOFAI editor · native renderer"
                                   Foreground="#C8D6EA"
                                   FontSize="14"
                                   Margin="2,7,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,24,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Starting ExtremeEditor…"
                                   Foreground="#E8F0FF"
                                   FontSize="12" />
                        <ProgressBar Grid.Row="1"
                                     Height="4"
                                     Margin="0,9,0,0"
                                     IsIndeterminate="True"
                                     BorderThickness="0"
                                     Background="#24FFFFFF"
                                     Foreground="#DDFBFF" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
