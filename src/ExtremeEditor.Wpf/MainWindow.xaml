<Window x:Class="ExtremeEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExtremeEditor.Wpf"
        xmlns:native="clr-namespace:ExtremeEditor.Wpf.Native"
        Width="1500"
        Height="900"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#14161A"
        Loaded="AssetSetupWindowLoaded"
        PreviewKeyDown="AdoFaiPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#14161A" />
        <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#20242A" />
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2B3038" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#363D47" />
        <SolidColorBrush x:Key="ControlPressedBrush" Color="#444D59" />
        <SolidColorBrush x:Key="DisabledControlBrush" Color="#252A31" />
        <SolidColorBrush x:Key="TextBrush" Color="#F2F4F7" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#BBC2CC" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#9EA7B3" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A525E" />
        <SolidColorBrush x:Key="SeparatorBrush" Color="#59626F" />

        <Style x:Key="EditorButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                    <Setter Property="Background" Value="{StaticResource DisabledControlBrush}" />
                    <Setter Property="BorderBrush" Value="#3D444E" />
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorToggleButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#35506F" />
                    <Setter Property="BorderBrush" Value="#6E9AC7" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                    <Setter Property="Background" Value="{StaticResource DisabledControlBrush}" />
                    <Setter Property="BorderBrush" Value="#3D444E" />
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorSeparatorStyle" TargetType="{x:Type Separator}">
            <Setter Property="Background" Value="{StaticResource SeparatorBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SeparatorBrush}" />
            <Setter Property="Margin" Value="5,4" />
        </Style>

        <Style x:Key="ToolbarGroupLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="7,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource EditorButtonStyle}" />
        <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource EditorToggleButtonStyle}" />
        <Style x:Key="{x:Static ToolBar.ButtonStyleKey}"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource EditorButtonStyle}" />
        <Style x:Key="{x:Static ToolBar.ToggleButtonStyleKey}"
               TargetType="{x:Type ToggleButton}"
               BasedOn="{StaticResource EditorToggleButtonStyle}" />
        <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}"
               TargetType="{x:Type Separator}"
               BasedOn="{StaticResource EditorSeparatorStyle}" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:EditorCommands.Open}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:EditorCommands.Save}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static local:EditorCommands.SaveAs}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static local:EditorCommands.Undo}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static local:EditorCommands.Redo}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{x:Static local:EditorCommands.Copy}" />
        <KeyBinding Key="X" Modifiers="Control" Command="{x:Static local:EditorCommands.Cut}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{x:Static local:EditorCommands.Paste}" />
    </Window.InputBindings>

    <DockPanel LastChildFill="True">
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{StaticResource ToolbarBackgroundBrush}"
                   Foreground="{StaticResource TextBrush}">
            <StatusBarItem HorizontalContentAlignment="Stretch"
                           Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type StatusBar}}}">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="PlaybackFpsText"
                               DockPanel.Dock="Right"
                               Text="FPS --"
                               Margin="12,0,8,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontFamily="Consolas"
                               ToolTip="Playback UI frame rate" />
                    <TextBlock x:Name="StatusText"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StatusBarItem>
        </StatusBar>

        <Border x:Name="DiagnosticsPanel"
                DockPanel.Dock="Bottom"
                Visibility="Collapsed"
                MaxHeight="150"
                Background="#191C21"
                BorderBrush="{StaticResource SeparatorBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="0,0,0,5">
                    <TextBlock Text="Playback diagnostics"
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Content="Hide"
                            Click="HideDiagnosticsClick"
                            Margin="10,0,0,0"
                            Padding="8,1"
                            MinHeight="23" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="PlaybackDiagnosticsText"
                               Text="A --:--.--- | C -- | playback diagnostics"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource ToolbarBackgroundBrush}"
                BorderBrush="{StaticResource SeparatorBrush}"
                BorderThickness="0,0,0,1">
            <Grid Height="31">
                <ToggleButton x:Name="ToolsButton"
                              Content="Tools"
                              HorizontalAlignment="Left"
                              Padding="10,2"
                              Margin="3,2" />
                <Popup x:Name="ToolsPopup"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=ToolsButton}"
                       IsOpen="{Binding IsChecked, ElementName=ToolsButton, Mode=TwoWay}"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border x:Name="ToolsPopupPanel"
                            Width="440"
                            Background="{StaticResource ToolbarBackgroundBrush}"
                            BorderBrush="{StaticResource ControlBorderBrush}"
                            BorderThickness="1"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="ASSETS"
                                       Style="{StaticResource ToolbarGroupLabelStyle}"
                                       Margin="0,0,0,4" />
                            <TextBlock x:Name="AdoFaiPathText"
                                       Text="Detecting…"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="Current ADOFAI installation"
                                       Margin="0,0,0,7" />
                            <WrapPanel>
                                <Button x:Name="BrowseAdoFaiButton"
                                        Content="Browse for ADOFAI…"
                                        Click="BrowseAdoFaiClick" />
                                <Button x:Name="SetupAssetsButton"
                                        Content="Setup Assets"
                                        Click="SetupAssetsClick" />
                            </WrapPanel>
                            <Separator Height="1"
                                       Margin="0,8"
                                       Background="{StaticResource SeparatorBrush}" />
                            <ToggleButton x:Name="DiagnosticsMenuItem"
                                          Content="Show Diagnostics"
                                          HorizontalAlignment="Left"
                                          Checked="DiagnosticsVisibilityChanged"
                                          Unchecked="DiagnosticsVisibilityChanged" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <ToolBarTray x:Name="TopToolBarTray"
                     DockPanel.Dock="Top"
                     Background="{StaticResource ToolbarBackgroundBrush}"
                     IsLocked="True">
            <ToolBar x:Name="FileHistoryToolBar"
                     Band="0"
                     Background="{StaticResource ToolbarBackgroundBrush}"
                     Foreground="{StaticResource TextBrush}">
                <TextBlock Text="FILE"
                           Style="{StaticResource ToolbarGroupLabelStyle}" />
                <Button Content="Open"
                        Command="{x:Static local:EditorCommands.Open}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <Button Content="Save"
                        Command="{x:Static local:EditorCommands.Save}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <Button Content="Save As"
                        Command="{x:Static local:EditorCommands.SaveAs}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <Separator />
                <TextBlock Text="HISTORY"
                           Style="{StaticResource ToolbarGroupLabelStyle}" />
                <Button Content="Undo"
                        Command="{x:Static local:EditorCommands.Undo}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <Button Content="Redo"
                        Command="{x:Static local:EditorCommands.Redo}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
            </ToolBar>

            <ToolBar x:Name="ClipboardViewToolBar"
                     Band="0"
                     Background="{StaticResource ToolbarBackgroundBrush}"
                     Foreground="{StaticResource TextBrush}">
                <TextBlock Text="CLIPBOARD"
                           Style="{StaticResource ToolbarGroupLabelStyle}" />
                <Button Content="Cut"
                        Command="{x:Static local:EditorCommands.Cut}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <Button Content="Copy"
                        Command="{x:Static local:EditorCommands.Copy}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <Button Content="Paste"
                        Command="{x:Static local:EditorCommands.Paste}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <Separator />
                <TextBlock Text="VIEW"
                           Style="{StaticResource ToolbarGroupLabelStyle}" />
                <Button Content="Frame"
                        Command="{x:Static local:EditorCommands.Frame}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
            </ToolBar>

            <ToolBar x:Name="TransformToolBar"
                     Band="1"
                     Background="{StaticResource ToolbarBackgroundBrush}"
                     Foreground="{StaticResource TextBrush}">
                <TextBlock Text="TRANSFORM"
                           Style="{StaticResource ToolbarGroupLabelStyle}" />
                <Button Content="+ Angle"
                        Command="{x:Static local:EditorCommands.InsertAngle}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <Button Content="-90°"
                        Command="{x:Static local:EditorCommands.RotateLeft}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <Button Content="+90°"
                        Command="{x:Static local:EditorCommands.RotateRight}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <Button Content="Flip H"
                        Command="{x:Static local:EditorCommands.FlipHorizontal}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <Button Content="Flip V"
                        Command="{x:Static local:EditorCommands.FlipVertical}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
            </ToolBar>

            <ToolBar x:Name="PlaybackToolBar"
                     Band="1"
                     Background="{StaticResource ToolbarBackgroundBrush}"
                     Foreground="{StaticResource TextBrush}">
                <TextBlock Text="PLAYBACK"
                           Style="{StaticResource ToolbarGroupLabelStyle}" />
                <Button x:Name="PlayButton"
                        Content="Play"
                        Command="{x:Static local:EditorCommands.PlayPause}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <Button Content="Stop"
                        Command="{x:Static local:EditorCommands.Stop}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <ToggleButton x:Name="FollowPlayerToggle"
                              Content="Follow Player"
                              IsChecked="True" />
                <ToggleButton x:Name="HitSoundsToggle"
                              Content="Hitsounds"
                              IsChecked="True"
                              Checked="HitSoundsToggleChanged"
                              Unchecked="HitSoundsToggleChanged" />
            </ToolBar>
        </ToolBarTray>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <native:NativeLevelViewport x:Name="NativeViewport"
                                        Grid.Column="0" />

            <Border Grid.Column="1"
                    Background="#1A1D22"
                    BorderBrush="#30343B"
                    BorderThickness="1,0,0,0"
                    Padding="10">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Selection / Events"
                                   Foreground="#F0F0F4"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                        <TextBlock x:Name="SelectionSummaryText"
                                   Text="No floor selected"
                                   Foreground="#AEB4C0"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Add Event"
                                    Command="{x:Static local:EditorCommands.AddEvent}"
                                    Margin="0,0,6,0" />
                            <Button Content="Delete Event"
                                    Command="{x:Static local:EditorCommands.DeleteEvent}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="EventList"
                                 Grid.Row="0"
                                 Background="#111318"
                                 Foreground="#E4E7EC"
                                 BorderBrush="#30343B"
                                 SelectionChanged="EventListSelectionChanged" />

                        <TextBox x:Name="EventEditorText"
                                 Grid.Row="2"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Background="#111318"
                                 Foreground="#E4E7EC"
                                 BorderBrush="#30343B"
                                 TextWrapping="NoWrap" />

                        <Button Grid.Row="3"
                                Content="Apply Event JSON"
                                Command="{x:Static local:EditorCommands.ApplyEvent}"
                                Margin="0,8,0,0" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
