<Window x:Class="ExtremeEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExtremeEditor.Wpf"
        xmlns:native="clr-namespace:ExtremeEditor.Wpf.Native"
        Width="1500"
        Height="900"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#14161A"
        PreviewKeyDown="AdoFaiPreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:EditorCommands.Open}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:EditorCommands.Save}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static local:EditorCommands.SaveAs}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static local:EditorCommands.Undo}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static local:EditorCommands.Redo}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{x:Static local:EditorCommands.Copy}" />
        <KeyBinding Key="X" Modifiers="Control" Command="{x:Static local:EditorCommands.Cut}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{x:Static local:EditorCommands.Paste}" />
    </Window.InputBindings>

    <DockPanel LastChildFill="True">
        <StatusBar DockPanel.Dock="Bottom"
                   Background="#1A1D22"
                   Foreground="#DCDCE6">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" />
            </StatusBarItem>
        </StatusBar>

        <ToolBarTray x:Name="TopToolBarTray"
                     DockPanel.Dock="Top"
                     Background="#1A1D22"
                     IsLocked="True">
            <ToolBar Band="0"
                     Background="#1A1D22"
                     Foreground="#DCDCE6">
                <Button Content="Open" Command="{x:Static local:EditorCommands.Open}" />
                <Button Content="Save" Command="{x:Static local:EditorCommands.Save}" />
                <Button Content="Save As" Command="{x:Static local:EditorCommands.SaveAs}" />
                <Separator />
                <Button Content="Undo" Command="{x:Static local:EditorCommands.Undo}" />
                <Button Content="Redo" Command="{x:Static local:EditorCommands.Redo}" />
                <Button Content="Cut" Command="{x:Static local:EditorCommands.Cut}" />
                <Button Content="Copy" Command="{x:Static local:EditorCommands.Copy}" />
                <Button Content="Paste" Command="{x:Static local:EditorCommands.Paste}" />
                <Button Content="Delete" Command="{x:Static local:EditorCommands.Delete}" />
                <Separator />
                <Button Content="+ Angle" Command="{x:Static local:EditorCommands.InsertAngle}" />
                <Button Content="+ Midspin" Command="{x:Static local:EditorCommands.InsertMidspin}" />
                <Button Content="+ 360°" Command="{x:Static local:EditorCommands.InsertFullTurn}" />
                <Button Content="-90°" Command="{x:Static local:EditorCommands.RotateLeft}" />
                <Button Content="+90°" Command="{x:Static local:EditorCommands.RotateRight}" />
                <Button Content="180°" Command="{x:Static local:EditorCommands.Rotate180}" />
                <Button Content="Flip H" Command="{x:Static local:EditorCommands.FlipHorizontal}" />
                <Button Content="Flip V" Command="{x:Static local:EditorCommands.FlipVertical}" />
                <Separator />
                <Button Content="Frame" Command="{x:Static local:EditorCommands.Frame}" />
                <Button x:Name="PlayButton"
                        Content="Play"
                        Command="{x:Static local:EditorCommands.PlayPause}" />
                <Button Content="Stop" Command="{x:Static local:EditorCommands.Stop}" />
                <ToggleButton x:Name="FollowPlayerToggle"
                              Content="Follow Player"
                              IsChecked="True" />
                <ToggleButton x:Name="HitSoundsToggle"
                              Content="Hitsounds"
                              IsChecked="True"
                              Checked="HitSoundsToggleChanged"
                              Unchecked="HitSoundsToggleChanged" />
                <ToggleButton x:Name="FloorPreviewToggle"
                              Content="Floor Preview"
                              IsChecked="True" />
                <ToggleButton x:Name="NativeViewportToggle"
                              Content="Native Viewport"
                              Checked="NativeViewportToggleChanged"
                              Unchecked="NativeViewportToggleChanged" />
            </ToolBar>

            <ToolBar x:Name="PlaybackDiagnosticsBar"
                     Band="1"
                     Background="#1A1D22"
                     Foreground="#DCDCE6">
                <TextBlock x:Name="PlaybackDiagnosticsText"
                           Text="A --:--.--- | C -- | playback diagnostics"
                           Width="{Binding ActualWidth, ElementName=TopToolBarTray}"
                           Margin="8,2"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#DCDCE6"
                           TextWrapping="Wrap"
                           ToolBar.OverflowMode="Never" />
            </ToolBar>
        </ToolBarTray>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <local:LevelViewport x:Name="Viewport" />
                <native:NativeLevelViewport x:Name="NativeViewport"
                                            Visibility="Collapsed" />
            </Grid>

            <Border Grid.Column="1"
                    Background="#1A1D22"
                    BorderBrush="#30343B"
                    BorderThickness="1,0,0,0"
                    Padding="10">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Selection / Events"
                                   Foreground="#F0F0F4"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                        <TextBlock x:Name="SelectionSummaryText"
                                   Text="No floor selected"
                                   Foreground="#AEB4C0"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Add Event"
                                    Command="{x:Static local:EditorCommands.AddEvent}"
                                    Margin="0,0,6,0" />
                            <Button Content="Delete Event"
                                    Command="{x:Static local:EditorCommands.DeleteEvent}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="EventList"
                                 Grid.Row="0"
                                 Background="#111318"
                                 Foreground="#E4E7EC"
                                 BorderBrush="#30343B"
                                 SelectionChanged="EventListSelectionChanged" />

                        <TextBox x:Name="EventEditorText"
                                 Grid.Row="2"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Background="#111318"
                                 Foreground="#E4E7EC"
                                 BorderBrush="#30343B"
                                 TextWrapping="NoWrap" />

                        <Button Grid.Row="3"
                                Content="Apply Event JSON"
                                Command="{x:Static local:EditorCommands.ApplyEvent}"
                                Margin="0,8,0,0" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
