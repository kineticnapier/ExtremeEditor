<Window x:Class="ExtremeEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExtremeEditor.Wpf"
        xmlns:native="clr-namespace:ExtremeEditor.Wpf.Native"
        Width="1400"
        Height="850"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#14161A">
    <DockPanel LastChildFill="True">
        <StatusBar DockPanel.Dock="Bottom"
                   Background="#1A1D22"
                   Foreground="#DCDCE6">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" />
            </StatusBarItem>
        </StatusBar>

        <ToolBarTray x:Name="TopToolBarTray"
                     DockPanel.Dock="Top"
                     Background="#1A1D22"
                     IsLocked="True">
            <ToolBar Band="0"
                     Background="#1A1D22"
                     Foreground="#DCDCE6">
                <Button Content="Open"
                        Command="{x:Static local:EditorCommands.Open}" />
                <Button Content="Frame"
                        Command="{x:Static local:EditorCommands.Frame}" />
                <Separator />
                <Button x:Name="PlayButton"
                        Content="Play"
                        Command="{x:Static local:EditorCommands.PlayPause}" />
                <Button Content="Stop"
                        Command="{x:Static local:EditorCommands.Stop}" />
                <ToggleButton x:Name="FollowPlayerToggle"
                              Content="Follow Player"
                              IsChecked="True" />
                <ToggleButton x:Name="HitSoundsToggle"
                              Content="Hitsounds"
                              IsChecked="True"
                              Checked="HitSoundsToggleChanged"
                              Unchecked="HitSoundsToggleChanged" />
                <Separator />
                <Button Content="-15°"
                        Command="{x:Static local:EditorCommands.RotateLeft}"
                        IsEnabled="False" />
                <Button Content="+15°"
                        Command="{x:Static local:EditorCommands.RotateRight}"
                        IsEnabled="False" />
                <Button Content="Save As"
                        Command="{x:Static local:EditorCommands.SaveAs}"
                        IsEnabled="False" />
                <Separator />
                <Button Content="Import Probe Assets"
                        IsEnabled="False" />
                <Button Content="Import Icon Catalog"
                        IsEnabled="False" />
                <Button Content="Import Hitsounds"
                        IsEnabled="False" />
                <ToggleButton x:Name="FloorPreviewToggle"
                              Content="Floor Preview"
                              IsChecked="True" />
                <ToggleButton x:Name="NativeViewportToggle"
                              Content="Native Viewport"
                              Checked="NativeViewportToggleChanged"
                              Unchecked="NativeViewportToggleChanged" />
                <Separator />
                <Button Content="Benchmark viewport"
                        IsEnabled="False" />
            </ToolBar>

            <ToolBar x:Name="PlaybackDiagnosticsBar"
                     Band="1"
                     Background="#1A1D22"
                     Foreground="#DCDCE6">
                <TextBlock x:Name="PlaybackDiagnosticsText"
                           Text="A --:--.--- | C -- | playback diagnostics"
                           Width="{Binding ActualWidth, ElementName=TopToolBarTray}"
                           Margin="8,2"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#DCDCE6"
                           TextWrapping="Wrap"
                           ToolBar.OverflowMode="Never" />
            </ToolBar>
        </ToolBarTray>

        <Grid>
            <local:LevelViewport x:Name="Viewport" />
            <native:NativeLevelViewport x:Name="NativeViewport"
                                        Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
