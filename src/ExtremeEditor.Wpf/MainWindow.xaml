<Window x:Class="ExtremeEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExtremeEditor.Wpf"
        xmlns:native="clr-namespace:ExtremeEditor.Wpf.Native"
        Width="1500"
        Height="900"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#14161A"
        Loaded="AssetSetupWindowLoaded"
        PreviewKeyDown="AdoFaiPreviewKeyDown"
        PreviewMouseWheel="MainWindowPreviewMouseWheel">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Menus.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:EditorCommands.Open}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:EditorCommands.Save}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static local:EditorCommands.SaveAs}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static local:EditorCommands.Undo}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static local:EditorCommands.Redo}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{x:Static ApplicationCommands.Copy}" />
        <KeyBinding Key="X" Modifiers="Control" Command="{x:Static ApplicationCommands.Cut}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{x:Static ApplicationCommands.Paste}" />
    </Window.InputBindings>

    <DockPanel LastChildFill="True">
        <StatusBar x:Name="StatusBarHost"
                   DockPanel.Dock="Bottom"
                   Background="{StaticResource ToolbarBackgroundBrush}"
                   Foreground="{StaticResource TextBrush}">
            <StatusBarItem HorizontalContentAlignment="Stretch"
                           Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type StatusBar}}}">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="PlaybackFpsText"
                               DockPanel.Dock="Right"
                               Text="FPS --"
                               Margin="12,0,8,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontFamily="Consolas"
                               ToolTip="Playback UI frame rate" />
                    <TextBlock x:Name="StatusText"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StatusBarItem>
        </StatusBar>

        <Border x:Name="DiagnosticsPanel"
                DockPanel.Dock="Bottom"
                Visibility="Collapsed"
                MaxHeight="150"
                Background="#191C21"
                BorderBrush="{StaticResource SeparatorBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="0,0,0,5">
                    <TextBlock Text="Playback diagnostics"
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Content="Hide"
                            Click="HideDiagnosticsClick"
                            Margin="10,0,0,0"
                            Padding="8,1"
                            MinHeight="23" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="PlaybackDiagnosticsText"
                               Text="A --:--.--- | C -- | playback diagnostics"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem x:Name="FileMenu" Header="_File">
                <MenuItem x:Name="FileNewMenu" Header="_New Tab" Click="NewDocumentTabClick" InputGestureText="Ctrl+N" />
                <MenuItem x:Name="FileOpenMenu" Header="_Open"
                          Command="{x:Static local:EditorCommands.Open}"
                          InputGestureText="Ctrl+O" />
                <MenuItem x:Name="FileSaveMenu" Header="_Save"
                          Command="{x:Static local:EditorCommands.Save}"
                          InputGestureText="Ctrl+S" />
                <MenuItem x:Name="FileSaveAsMenu" Header="Save _As"
                          Command="{x:Static local:EditorCommands.SaveAs}"
                          InputGestureText="Ctrl+Shift+S" />
                <MenuItem x:Name="ExportVideoMenuItem"
                          Header="Export _Video…"
                          Click="ExportVideoClick" />
                <Separator />
                <MenuItem x:Name="FileSettingsMenu" Header="_Settings">
                    <MenuItem x:Name="FileLanguageMenu" Header="_Language">
                        <MenuItem x:Name="LanguageSystemMenu" Header="System" Tag="system" Click="LanguageMenuClick" IsCheckable="True"/>
                        <MenuItem x:Name="LanguageEnglishMenu" Header="English" Tag="en" Click="LanguageMenuClick" IsCheckable="True"/>
                        <MenuItem x:Name="LanguageJapaneseMenu" Header="日本語" Tag="ja" Click="LanguageMenuClick" IsCheckable="True"/>
                    </MenuItem>
                </MenuItem>
                <Separator />
                <MenuItem x:Name="ExitMenuItem" Header="E_xit" Click="ExitClick" />
            </MenuItem>
            <MenuItem x:Name="EditMenu" Header="_Edit">
                <MenuItem x:Name="EditUndoMenu" Header="_Undo"
                          Command="{x:Static local:EditorCommands.Undo}"
                          InputGestureText="Ctrl+Z" />
                <MenuItem x:Name="EditRedoMenu" Header="_Redo"
                          Command="{x:Static local:EditorCommands.Redo}"
                          InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem x:Name="EditCutMenu" Header="Cu_t"
                          Command="{x:Static local:EditorCommands.Cut}"
                          InputGestureText="Ctrl+X" />
                <MenuItem x:Name="EditCopyMenu" Header="_Copy"
                          Command="{x:Static local:EditorCommands.Copy}"
                          InputGestureText="Ctrl+C" />
                <MenuItem x:Name="EditPasteMenu" Header="_Paste"
                          Command="{x:Static local:EditorCommands.Paste}"
                          InputGestureText="Ctrl+V" />
                <MenuItem Header="Paste at _End"
                          Command="{x:Static local:EditorCommands.PasteAtEnd}" />
                <Separator />
                <MenuItem x:Name="EditGoToMenu" Header="_Go to Floor…"
                          InputGestureText="Ctrl+G"
                          Click="GoToFloorClick" />
                <Separator />
                <MenuItem x:Name="TransformMenu" Header="_Transform">
                    <MenuItem x:Name="EditAngleMenu" Header="_Angle…"
                              Command="{x:Static local:EditorCommands.InsertAngle}"
                              InputGestureText="Enter" />
                    <MenuItem x:Name="EditRotateLeftMenu" Header="Rotate -90°"
                              Command="{x:Static local:EditorCommands.RotateLeft}"
                              InputGestureText="Ctrl+." />
                    <MenuItem x:Name="EditRotateRightMenu" Header="Rotate +90°"
                              Command="{x:Static local:EditorCommands.RotateRight}"
                              InputGestureText="Ctrl+," />
                    <Separator />
                    <MenuItem x:Name="EditFlipHorizontalMenu" Header="Flip _Horizontal"
                              Command="{x:Static local:EditorCommands.FlipHorizontal}"
                              InputGestureText="Ctrl+L" />
                    <MenuItem x:Name="EditFlipVerticalMenu" Header="Flip _Vertical"
                              Command="{x:Static local:EditorCommands.FlipVertical}"
                              InputGestureText="Ctrl+Shift+L" />
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="ViewMenu" Header="_View">
                <MenuItem x:Name="ViewFrameMenu" Header="_Frame"
                          Command="{x:Static local:EditorCommands.Frame}" />
                <MenuItem x:Name="ViewFollowPlayerMenuItem"
                          Header="Follow _Player"
                          IsCheckable="True"
                          IsChecked="{Binding IsChecked, ElementName=FollowPlayerToggle, Mode=TwoWay}" />
                <Separator />
                <MenuItem x:Name="DiagnosticsMenuItem"
                          Header="Show _Diagnostics"
                          IsCheckable="True"
                          Checked="DiagnosticsVisibilityChanged"
                          Unchecked="DiagnosticsVisibilityChanged" />
            </MenuItem>
            <MenuItem x:Name="ToolsMenu" Header="_Tools">
                <MenuItem x:Name="AssetsMenu" Header="_Assets">
                    <MenuItem x:Name="AdoFaiPathMenuItem"
                              Header="ADOFAI: Detecting…"
                              IsEnabled="False"
                              ToolTipService.ShowOnDisabled="True" />
                    <Separator />
                    <MenuItem x:Name="BrowseAdoFaiMenuItem"
                              Header="Browse for ADOFAI…"
                              Click="BrowseAdoFaiClick" />
                    <MenuItem x:Name="SetupAssetsMenuItem"
                              Header="Setup Assets"
                              Click="SetupAssetsClick" />
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="HelpMenu" Header="_Help">
                <MenuItem x:Name="AboutMenuItem" Header="_About ExtremeEditor" Click="AboutClick" />
            </MenuItem>
        </Menu>

        <Border x:Name="ToolbarHost"
                DockPanel.Dock="Top"
                Background="{StaticResource ToolbarBackgroundBrush}"
                BorderBrush="{StaticResource SeparatorBrush}"
                BorderThickness="0,0,0,1"
                Padding="3,2">
            <StackPanel x:Name="MainToolBar"
                        Orientation="Horizontal">
                <Button x:Name="ToolbarOpenButton" Content="Open"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Static local:EditorCommands.Open}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <Button x:Name="ToolbarSaveButton" Content="Save"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Static local:EditorCommands.Save}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <Border Width="1" Height="18" Margin="6,4" Background="{StaticResource SeparatorBrush}" />
                <Button x:Name="ToolbarFrameButton" Content="Frame"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Static local:EditorCommands.Frame}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <Border Width="1" Height="18" Margin="6,4" Background="{StaticResource SeparatorBrush}" />
                <Button x:Name="PlayButton"
                        Content="Play"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Static local:EditorCommands.PlayPause}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <Button x:Name="ToolbarStopButton" Content="Stop"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{x:Static local:EditorCommands.Stop}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                <TextBlock x:Name="ToolbarSpeedLabel" Text="Speed"
                           VerticalAlignment="Center"
                           Margin="8,0,4,0"
                           Foreground="#D9DCE3" />
                <TextBox x:Name="PlaybackSpeedTextBox"
                         Width="54"
                         Height="24"
                         Text="1x"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Right"
                         ToolTip="Playback speed (0.01x–10x)"
                         PreviewKeyDown="PlaybackSpeedTextBoxPreviewKeyDown"
                         LostKeyboardFocus="PlaybackSpeedTextBoxLostKeyboardFocus" />
                <Button Content="1x"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Margin="3,0,4,0"
                        Padding="6,1"
                        ToolTip="Reset playback speed"
                        Click="ResetPlaybackSpeedClick" />
                <ToggleButton x:Name="FollowPlayerToggle"
                              Content="Follow"
                              Style="{StaticResource ToolbarToggleButtonStyle}"
                              IsChecked="True" />
                <ToggleButton x:Name="HitSoundsToggle"
                              Content="Hitsounds"
                              Style="{StaticResource ToolbarToggleButtonStyle}"
                              IsChecked="True"
                              Checked="HitSoundsToggleChanged"
                              Unchecked="HitSoundsToggleChanged" />
            </StackPanel>
        </Border>

        <!-- Tabs remain in document creation order; selection changes appearance only.
             It shares the toolbar's visibility so Clean Play continues to be chrome-free. -->
        <Border x:Name="DocumentTabStrip"
                DockPanel.Dock="Top"
                Height="33"
                Background="#1B1F25"
                BorderBrush="{StaticResource SeparatorBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding Visibility, ElementName=ToolbarHost}">
            <DockPanel Margin="7,3,7,0" LastChildFill="True">
                <!-- Keep the new-tab button reachable even when the tab row overflows. -->
                <Button x:Name="WelcomeTabButton"
                        DockPanel.Dock="Left"
                        Content="Welcome"
                        Click="WelcomeTabClick"
                        Margin="0,0,8,3"
                        Padding="11,0"
                        ToolTip="Open welcome page" />
                <Button x:Name="AddDocumentTabButton"
                        DockPanel.Dock="Right"
                        Content="+"
                        Click="NewDocumentTabClick"
                        Margin="6,0,0,3"
                        Padding="10,0"
                        MinWidth="30"
                        FontSize="15"
                        ToolTip="New chart tab (Ctrl+N)"
                        AutomationProperties.Name="New chart tab" />
                <Button DockPanel.Dock="Right"
                        Content="›"
                        Click="ScrollDocumentTabsRightClick"
                        Margin="2,0,0,3"
                        Padding="5,0"
                        MinWidth="24"
                        ToolTip="Scroll chart tabs right"
                        AutomationProperties.Name="Scroll chart tabs right" />
                <Button DockPanel.Dock="Right"
                        Content="‹"
                        Click="ScrollDocumentTabsLeftClick"
                        Margin="2,0,0,3"
                        Padding="5,0"
                        MinWidth="24"
                        ToolTip="Scroll chart tabs left"
                        AutomationProperties.Name="Scroll chart tabs left" />
                <ScrollViewer x:Name="DocumentTabsScrollViewer"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PreviewMouseWheel="DocumentTabsScrollViewerPreviewMouseWheel"
                              SizeChanged="DocumentTabsScrollViewerSizeChanged">
                    <StackPanel x:Name="DocumentTabsHost"
                                Orientation="Horizontal" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid>
        <Grid x:Name="EditorShellGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SettingsRailColumn" Width="40" />
                <ColumnDefinition x:Name="SettingsContentColumn" Width="280" MaxWidth="300" />
                <ColumnDefinition x:Name="EditorViewportColumn" Width="*" MinWidth="350" />
                <ColumnDefinition x:Name="EventInspectorColumn" Width="330" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="SettingsSidebarHost"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Background="#181B20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SettingsCategoryRail"
                        Grid.Column="0"
                        Width="40"
                        Background="#121419"
                        BorderBrush="#30343B"
                        BorderThickness="0,0,1,0">
                    <StackPanel>
                        <Button x:Name="SettingsSidebarCollapseButton"
                                Content="‹"
                                Height="36"
                                ToolTip="Collapse settings"
                                Click="SettingsSidebarCollapseClick" />
                        <ToggleButton x:Name="SongSettingsCategoryButton"
                                      Content="♫"
                                      Height="40"
                                      IsChecked="True"
                                      ToolTip="Song Settings"
                                      Click="SongSettingsCategoryClick" />
                        <ToggleButton x:Name="CameraSettingsCategoryButton"
                                      Content="◎"
                                      Height="40"
                                      ToolTip="Camera Settings"
                                      Click="CameraSettingsCategoryClick" />
                        <ToggleButton x:Name="TrackSettingsCategoryButton"
                                      Content="◇"
                                      Height="40"
                                      ToolTip="Track Settings"
                                      Click="TrackSettingsCategoryClick" />
                        <ToggleButton x:Name="LevelSettingsCategoryButton"
                                      Content="≡"
                                      Height="40"
                                      ToolTip="Level Settings"
                                      Click="LevelSettingsCategoryClick" />
                        <ToggleButton x:Name="MiscSettingsCategoryButton"
                                      Content="⋯"
                                      Height="40"
                                      ToolTip="Misc Settings"
                                      Click="MiscSettingsCategoryClick" />
                    </StackPanel>
                </Border>

                <Border x:Name="SongSettingsPane"
                        Grid.Column="1"
                        Background="#1A1D22"
                        BorderBrush="#30343B"
                        BorderThickness="0,0,1,0"
                        Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="L10nSongSettings" Text="Song Settings"
                                       Foreground="#F0F0F4"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,12" />

                            <TextBlock x:Name="L10nSongFilename" Text="Song filename" Foreground="#AEB4C0" />
                            <TextBox x:Name="SongFilenameTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="SongSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="SongSettingTextBoxLostKeyboardFocus" />

                            <TextBlock x:Name="L10nSongBpm" Text="Initial BPM" Foreground="#AEB4C0" />
                            <TextBox x:Name="SongBpmTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="SongSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="SongSettingTextBoxLostKeyboardFocus" />

                            <TextBlock x:Name="L10nSongVolume" Text="Song volume (%)" Foreground="#AEB4C0" />
                            <TextBox x:Name="SongVolumeTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="SongSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="SongSettingTextBoxLostKeyboardFocus" />

                            <TextBlock x:Name="L10nSongOffset" Text="Offset (ms)" Foreground="#AEB4C0" />
                            <TextBox x:Name="SongOffsetTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="SongSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="SongSettingTextBoxLostKeyboardFocus" />

                            <TextBlock x:Name="L10nSongPitch" Text="Pitch (%)" Foreground="#AEB4C0" />
                            <TextBox x:Name="SongPitchTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="SongSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="SongSettingTextBoxLostKeyboardFocus" />

                            <TextBlock x:Name="L10nSongHitSound" Text="Hitsound" Foreground="#AEB4C0" />
                            <ComboBox x:Name="SongHitSoundComboBox"
                                      Margin="0,3,0,10"
                                      SelectionChanged="SongHitSoundSelectionChanged">
                                <ComboBoxItem Content="Kick" />
                                <ComboBoxItem Content="Hat" />
                                <ComboBoxItem Content="Shaker" />
                                <ComboBoxItem Content="Sizzle" />
                                <ComboBoxItem Content="Chuck" />
                            </ComboBox>

                            <TextBlock x:Name="L10nSongHitSoundVolume" Text="Hitsound volume (%)" Foreground="#AEB4C0" />
                            <TextBox x:Name="SongHitSoundVolumeTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="SongSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="SongSettingTextBoxLostKeyboardFocus" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="CameraSettingsPane"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Background="#1A1D22"
                        BorderBrush="#30343B"
                        BorderThickness="0,0,1,0"
                        Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="L10nCameraSettings" Text="Camera Settings"
                                       Foreground="#F0F0F4"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,12" />

                            <TextBlock x:Name="L10nCameraRelativeTo" Text="Relative to" Foreground="#AEB4C0" />
                            <ComboBox x:Name="CameraRelativeToComboBox"
                                      Margin="0,3,0,10"
                                      SelectionChanged="CameraRelativeToSelectionChanged">
                                <ComboBoxItem Content="Player" />
                                <ComboBoxItem Content="Tile" />
                                <ComboBoxItem Content="Global" />
                            </ComboBox>

                            <TextBlock x:Name="L10nCameraPositionX" Text="Position X" Foreground="#AEB4C0" />
                            <TextBox x:Name="CameraPositionXTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="CameraSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="CameraSettingTextBoxLostKeyboardFocus" />

                            <TextBlock x:Name="L10nCameraPositionY" Text="Position Y" Foreground="#AEB4C0" />
                            <TextBox x:Name="CameraPositionYTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="CameraSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="CameraSettingTextBoxLostKeyboardFocus" />

                            <TextBlock x:Name="L10nCameraRotation" Text="Rotation (°)" Foreground="#AEB4C0" />
                            <TextBox x:Name="CameraRotationTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="CameraSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="CameraSettingTextBoxLostKeyboardFocus" />

                            <TextBlock x:Name="L10nCameraZoom" Text="Zoom (%)" Foreground="#AEB4C0" />
                            <TextBox x:Name="CameraZoomTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="CameraSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="CameraSettingTextBoxLostKeyboardFocus" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="TrackSettingsPane"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Background="#1A1D22"
                        BorderBrush="#30343B"
                        BorderThickness="0,0,1,0"
                        Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="L10nTrackSettings" Text="Track Settings"
                                       Foreground="#F0F0F4"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,12" />

                            <TextBlock x:Name="L10nTrackPrimaryColor" Text="Primary color (hex)" Foreground="#AEB4C0" />
                            <TextBox x:Name="TrackPrimaryColorTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="TrackSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="TrackSettingTextBoxLostKeyboardFocus" />

                            <TextBlock x:Name="L10nTrackSecondaryColor" Text="Secondary color (hex)" Foreground="#AEB4C0" />
                            <TextBox x:Name="TrackSecondaryColorTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="TrackSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="TrackSettingTextBoxLostKeyboardFocus" />

                            <TextBlock x:Name="L10nTrackColorType" Text="Color type" Foreground="#AEB4C0" />
                            <ComboBox x:Name="TrackColorTypeComboBox"
                                      Margin="0,3,0,10"
                                      SelectionChanged="TrackSettingComboBoxSelectionChanged">
                                <ComboBoxItem Content="Single" />
                                <ComboBoxItem Content="Stripes" />
                                <ComboBoxItem Content="Glow" />
                                <ComboBoxItem Content="Blink" />
                                <ComboBoxItem Content="Switch" />
                                <ComboBoxItem Content="Rainbow" />
                                <ComboBoxItem Content="Volume" />
                            </ComboBox>

                            <TextBlock x:Name="L10nTrackAnimationDuration" Text="Animation duration" Foreground="#AEB4C0" />
                            <TextBox x:Name="TrackColorAnimDurationTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="TrackSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="TrackSettingTextBoxLostKeyboardFocus" />

                            <TextBlock Text="Pulse" Foreground="#AEB4C0" />
                            <ComboBox x:Name="TrackColorPulseComboBox"
                                      Margin="0,3,0,10"
                                      SelectionChanged="TrackSettingComboBoxSelectionChanged">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="Forward" />
                                <ComboBoxItem Content="Backward" />
                            </ComboBox>

                            <TextBlock x:Name="L10nTrackPulseLength" Text="Pulse length" Foreground="#AEB4C0" />
                            <TextBox x:Name="TrackPulseLengthTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="TrackSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="TrackSettingTextBoxLostKeyboardFocus" />

                            <TextBlock Text="Style" Foreground="#AEB4C0" />
                            <ComboBox x:Name="TrackStyleComboBox"
                                      Margin="0,3,0,10"
                                      SelectionChanged="TrackSettingComboBoxSelectionChanged">
                                <ComboBoxItem Content="Standard" />
                                <ComboBoxItem Content="Neon" />
                                <ComboBoxItem Content="NeonLight" />
                                <ComboBoxItem Content="Basic" />
                                <ComboBoxItem Content="Gems" />
                                <ComboBoxItem Content="Minimal" />
                            </ComboBox>

                            <TextBlock x:Name="L10nTrackGlowIntensity" Text="Glow intensity (%)" Foreground="#AEB4C0" />
                            <TextBox x:Name="TrackGlowIntensityTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="TrackSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="TrackSettingTextBoxLostKeyboardFocus" />

                            <TextBlock Text="Animation"
                                       Foreground="#F0F0F4"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,10" />

                            <TextBlock Text="Appear animation" Foreground="#AEB4C0" />
                            <ComboBox x:Name="TrackAppearAnimationComboBox"
                                      Margin="0,3,0,10"
                                      SelectionChanged="TrackSettingComboBoxSelectionChanged">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="Assemble" />
                                <ComboBoxItem Content="Assemble_Far" />
                                <ComboBoxItem Content="Extend" />
                                <ComboBoxItem Content="Grow" />
                                <ComboBoxItem Content="Grow_Spin" />
                                <ComboBoxItem Content="Fade" />
                                <ComboBoxItem Content="Drop" />
                                <ComboBoxItem Content="Rise" />
                            </ComboBox>

                            <TextBlock Text="Beats ahead" Foreground="#AEB4C0" />
                            <TextBox x:Name="TrackBeatsAheadTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="TrackSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="TrackSettingTextBoxLostKeyboardFocus" />

                            <TextBlock Text="Disappear animation" Foreground="#AEB4C0" />
                            <ComboBox x:Name="TrackDisappearAnimationComboBox"
                                      Margin="0,3,0,10"
                                      SelectionChanged="TrackSettingComboBoxSelectionChanged">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="Scatter" />
                                <ComboBoxItem Content="Scatter_Far" />
                                <ComboBoxItem Content="Retract" />
                                <ComboBoxItem Content="Shrink" />
                                <ComboBoxItem Content="Shrink_Spin" />
                                <ComboBoxItem Content="Fade" />
                            </ComboBox>

                            <TextBlock Text="Beats behind" Foreground="#AEB4C0" />
                            <TextBox x:Name="TrackBeatsBehindTextBox"
                                     Margin="0,3,0,10"
                                     PreviewKeyDown="TrackSettingTextBoxPreviewKeyDown"
                                     LostKeyboardFocus="TrackSettingTextBoxLostKeyboardFocus" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="LevelSettingsPane"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Background="#1A1D22"
                        BorderBrush="#30343B"
                        BorderThickness="0,0,1,0"
                        Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Level Settings"
                                       Foreground="#F0F0F4"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Level / Song title" Foreground="#AEB4C0" />
                            <TextBox x:Name="LevelSongTitleTextBox"
                                     Margin="0,3,0,10"
                                     TextChanged="LevelMetadataTextChanged"
                                     PreviewKeyDown="LevelMetadataSingleLinePreviewKeyDown"
                                     LostKeyboardFocus="LevelMetadataTextBoxLostKeyboardFocus" />

                            <TextBlock Text="Artist" Foreground="#AEB4C0" />
                            <TextBox x:Name="LevelArtistTextBox"
                                     Margin="0,3,0,10"
                                     TextChanged="LevelMetadataTextChanged"
                                     PreviewKeyDown="LevelMetadataSingleLinePreviewKeyDown"
                                     LostKeyboardFocus="LevelMetadataTextBoxLostKeyboardFocus" />

                            <TextBlock Text="Mapper / Author" Foreground="#AEB4C0" />
                            <TextBox x:Name="LevelAuthorTextBox"
                                     Margin="0,3,0,10"
                                     TextChanged="LevelMetadataTextChanged"
                                     PreviewKeyDown="LevelMetadataSingleLinePreviewKeyDown"
                                     LostKeyboardFocus="LevelMetadataTextBoxLostKeyboardFocus" />

                            <TextBlock Text="Description" Foreground="#AEB4C0" />
                            <TextBox x:Name="LevelDescriptionTextBox"
                                     MinHeight="88"
                                     Margin="0,3,0,10"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="LevelMetadataTextChanged"
                                     LostKeyboardFocus="LevelMetadataTextBoxLostKeyboardFocus" />

                            <TextBlock Text="Tags" Foreground="#AEB4C0" />
                            <TextBox x:Name="LevelTagsTextBox"
                                     Margin="0,3,0,10"
                                     TextChanged="LevelMetadataTextChanged"
                                     PreviewKeyDown="LevelMetadataSingleLinePreviewKeyDown"
                                     LostKeyboardFocus="LevelMetadataTextBoxLostKeyboardFocus" />

                            <TextBlock Text="Artist links" Foreground="#AEB4C0" />
                            <TextBox x:Name="LevelArtistLinksTextBox"
                                     MinHeight="64"
                                     Margin="0,3,0,10"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="LevelMetadataTextChanged"
                                     LostKeyboardFocus="LevelMetadataTextBoxLostKeyboardFocus" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="MiscSettingsPane"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Background="#1A1D22"
                        BorderBrush="#30343B"
                        BorderThickness="0,0,1,0"
                        Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Misc Settings"
                                       Foreground="#F0F0F4"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,12" />
                            <TextBlock Text="Track behavior"
                                       Foreground="#AEB4C0"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <CheckBox x:Name="StickToFloorsCheckBox"
                                      Content="Stick track transforms to floors"
                                      Foreground="#E4E7EC"
                                      Margin="0,0,0,8"
                                      Checked="StickToFloorsCheckChanged"
                                      Unchecked="StickToFloorsCheckChanged" />
                            <CheckBox x:Name="FloorIconOutlinesCheckBox"
                                      Content="Show floor icon outlines"
                                      Foreground="#E4E7EC"
                                      Checked="StickToFloorsCheckChanged"
                                      Unchecked="StickToFloorsCheckChanged" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <native:NativeLevelViewport x:Name="NativeViewport"
                                        Grid.Column="2" />

            <Border x:Name="EventInspectorHost"
                    Grid.Column="3"
                    Background="#1A1D22"
                    BorderBrush="#30343B"
                    BorderThickness="1,0,0,0"
                    Padding="10">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Selection / Events"
                                   Foreground="#F0F0F4"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                        <TextBlock x:Name="SelectionSummaryText"
                                   Text="No floor selected"
                                   Foreground="#AEB4C0"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Add Event"
                                    Command="{x:Static local:EditorCommands.AddEvent}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="EventList"
                                 Grid.Row="0"
                                 Background="#111318"
                                 Foreground="#E4E7EC"
                                 BorderBrush="#30343B"
                                 SelectionChanged="EventListSelectionChanged" />

                        <TextBox x:Name="EventEditorText"
                                 Grid.Row="2"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Background="#111318"
                                 Foreground="#E4E7EC"
                                 BorderBrush="#30343B"
                                 TextWrapping="NoWrap" />

                        <Button Grid.Row="3"
                                Content="Apply Event JSON"
                                Command="{x:Static local:EditorCommands.ApplyEvent}"
                                Margin="0,8,0,0" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
        <Grid x:Name="WelcomePage" Visibility="Collapsed" Background="#14161A">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Width="550" HorizontalAlignment="Center"
                            Margin="24,80,24,60">
                    <TextBlock Text="ExtremeEditor" FontSize="38" FontWeight="SemiBold"
                               Foreground="#F0F2F5"/>
                    <TextBlock x:Name="WelcomeSubtitle" Text="Welcome" FontSize="16" Foreground="#9CA6B4"
                               Margin="0,2,0,30"/>
                    <Button x:Name="WelcomeNewButton" Content="New chart  (Ctrl+N)" Click="NewDocumentTabClick"
                            Height="52" Margin="0,0,0,12"/>
                    <Button x:Name="WelcomeOpenButton" Content="Open chart  (Ctrl+O)" Click="WelcomeOpenClick"
                            Height="52" Margin="0,0,0,28"/>
                    <TextBlock x:Name="WelcomeRecentTitle" Text="Recent charts" FontSize="18" FontWeight="SemiBold"
                               Foreground="#F0F2F5" Margin="0,0,0,12"/>
                                        <StackPanel x:Name="WelcomeRecentFilesHost"/>
                    <TextBlock x:Name="WelcomeRecentEmpty" Text="No recent charts yet."
                               Foreground="#9CA6B4"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
