<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <NativeRendererBuildDir>$(MSBuildThisFileDirectory)..\..\build\native-renderer</NativeRendererBuildDir>
    <NativeRendererDll>$(NativeRendererBuildDir)\$(Configuration)\ExtremeEditor.NativeRenderer.dll</NativeRendererDll>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExtremeEditor.Core\ExtremeEditor.Core.csproj" />
    <ProjectReference Include="..\ExtremeEditor.Wpf\ExtremeEditor.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NativeRendererDll)"
          Link="ExtremeEditor.NativeRenderer.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>
</Project>
